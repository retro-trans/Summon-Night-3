    },
    "00:00065:text:0002647c": {
      "source_sha256": "a3074b22f5199d2fc3f8c49f674eb6cee409d3401c432291ec9f7a0a08d0b229",
      "text": "Huh...?",
      "source_offset": 156796,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026488": {
      "source_sha256": "13b8d995017d9b65abb1e12099c816fb069fd476da5f4e03fc6afc34f7931115",
      "text": "Now, awaken...",
      "source_offset": 156808,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000264a2": {
      "source_sha256": "0639a2a70705e6cb5d15daf76044a2aabe869993c90035ede50df78ad5a1f2f6",
      "text": "A voice...",
      "source_offset": 156834,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000264ac": {
      "source_sha256": "83fc3b1d626449478f2fa5c80f0f44f8cbf1fa62ea7b0244efc96ea0ba090719",
      "text": "Is it calling me?",
      "source_offset": 156844,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000264c2": {
      "source_sha256": "0639a2a70705e6cb5d15daf76044a2aabe869993c90035ede50df78ad5a1f2f6",
      "text": "A voice...",
      "source_offset": 156866,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000264cc": {
      "source_sha256": "c8bb25bb0796bd5dd55de19104f6581cfa1936a94aa24a5b33b35b659076ba49",
      "text": "Is it calling...",
      "source_offset": 156876,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000264d8": {
      "source_sha256": "9dc5d2517381612ca874835b6f778ace2076cf36fad5c4f7f5ae3b57f8e9a12c",
      "text": "for me?",
      "source_offset": 156888,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000264e8": {
      "source_sha256": "25989ebc48b0d6e3e1adaf528660f11aadc69d580e6d05e17dc844ea90e49abd",
      "text": "But who? From where?",
      "source_offset": 156904,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026502": {
      "source_sha256": "3e9f3894b8aee6394dab22bc77d361fc3ac25e56c32e85fee01c30ef08c39199",
      "text": "Open your eyes...",
      "source_offset": 156930,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026514": {
      "source_sha256": "8ba68428fa4211a9214dc970cdc2c51c08dfe2e0c476481647eb2134b4ea87ec",
      "text": "and rise...",
      "source_offset": 156948,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:0002652a": {
      "source_sha256": "9aff3d50a7706323400100cd25d91843cfd84bdba24d4cb71ed0353816fbe866",
      "text": "U-ugh...",
      "source_offset": 156970,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:0002653a": {
      "source_sha256": "55d4f06b00a025f49d63e756f3280b53fa9fc28227bf7fcfdca8ed6365e61242",
      "text": "You who...",
      "source_offset": 156986,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026546": {
      "source_sha256": "1a96cb2d81974dfc269da9e834419189cc5ef03264489d8ae953644db13da02f",
      "text": "have inherited me!",
      "source_offset": 156998,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026556": {
      "source_sha256": "36fe1cfbab52f30818446adae5ddc42cb9f4e9ade683f363e1935f37674c9b6a",
      "text": "...wake up.",
      "source_offset": 157014,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026566": {
      "source_sha256": "a3074b22f5199d2fc3f8c49f674eb6cee409d3401c432291ec9f7a0a08d0b229",
      "text": "Huh...?",
      "source_offset": 157030,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026572": {
      "source_sha256": "e0ce1e1b548777d2a93acf59949a5268783592e4993e7674b25b5d9e0bd9c681",
      "text": "Come on, wake up...",
      "source_offset": 157042,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:0002658c": {
      "source_sha256": "0639a2a70705e6cb5d15daf76044a2aabe869993c90035ede50df78ad5a1f2f6",
      "text": "A voice...",
      "source_offset": 157068,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026596": {
      "source_sha256": "83fc3b1d626449478f2fa5c80f0f44f8cbf1fa62ea7b0244efc96ea0ba090719",
      "text": "Is it calling me?",
      "source_offset": 157078,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000265ac": {
      "source_sha256": "0639a2a70705e6cb5d15daf76044a2aabe869993c90035ede50df78ad5a1f2f6",
