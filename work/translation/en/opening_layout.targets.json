      "text": "So...",
      "source_offset": 157308,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:0002668a": {
      "source_sha256": "ddc8ac9864330fc398ab1a4c90b6f83a8728028eb298baea3c229526a0422123",
      "text": "Please...",
      "source_offset": 157322,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026696": {
      "source_sha256": "a2b23c7e523e0ac90b4d632a5adb7b784b9eddd2ea8cc7ac29f2324d109f86e4",
      "text": "stop me...",
      "source_offset": 157334,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
