    "00:00065:text:0002646e": {
      "source_sha256": "1dcea15a9df627b32a9a593c48eed9bff9ce8628a6af7b6776757e4b6cfe574b",
      "text": "...waken.",
      "source_offset": 156782,
      "status": "meaning_reviewed",
