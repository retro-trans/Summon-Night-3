      "text": "Um...",
      "source_offset": 157538,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026772": {
      "source_sha256": "2e28d4572dab66e183d937802c09f239f4873ba59c69c6ed776d9088a6b9ccff",
      "text": "Why was I",
      "source_offset": 157554,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026786": {
      "source_sha256": "dc6041a6c6b1b2ede85ff2a70928467a599b29f4078206737f4027f5fafe2b45",
      "text": "sleeping on the beach?",
      "source_offset": 157574,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:0002679c": {
      "source_sha256": "a94cbce1f72099d5bcae76a5eb4688a4fb9366c54fe64d829e31d6dc40a1ba01",
      "text": "No...",
      "source_offset": 157596,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000267aa": {
      "source_sha256": "d639e43517f8924ce00b6fce5ea471e0c94f95ac55ea7e6f9f90db65f9a62b37",
      "text": "Before that...",
      "source_offset": 157610,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000267bc": {
      "source_sha256": "f405004c5593da2bd1e008c3b095db65c3c25c980e7b5c65b0a5eda87ec54fa6",
      "text": "Where is this??",
      "source_offset": 157628,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000267d2": {
      "source_sha256": "2487976555c620b50f9a7d57f0df6d3ded063e761adfaf8fb773d23f87201a14",
      "text": "This is bad...",
      "source_offset": 157650,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000267e4": {
      "source_sha256": "683d87f932c031699a365fd6cfb016cf31b9778c9f121879a4ce6579bc6e90c4",
      "text": "Not a house in sight,",
      "source_offset": 157668,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000267fa": {
      "source_sha256": "0aa75e0923fe3ec1658111ad3626cf94de1216970a61493f3b0f1d8d673664c7",
      "text": "or even a single person.",
      "source_offset": 157690,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:0002680e": {
      "source_sha256": "2db3988dd20d8368fe053c07ddc0a427de234122a77589050a862888ef1a73a2",
      "text": "What a mess...",
      "source_offset": 157710,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026822": {
      "source_sha256": "c195acc327b3b2a6209b72c01b6db475f088dcae6f3ec5ce5cfec9b7c3f8f3f9",
      "text": "Not a house in sight,",
      "source_offset": 157730,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026836": {
      "source_sha256": "0aa75e0923fe3ec1658111ad3626cf94de1216970a61493f3b0f1d8d673664c7",
      "text": "or even a single soul.",
      "source_offset": 157750,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:0002684a": {
      "source_sha256": "418dbb59af01f54e0911fa953a9e2e8b89d526cf33cc9a3c069700db3c3bf488",
      "text": "And this scenery...",
      "source_offset": 157770,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:0002685a": {
      "source_sha256": "ec1dd1f898a1da9689adb2428603e1db17eccdc3e6da31bee9c573c93e46a8a8",
      "text": "No matter how I look at it,",
      "source_offset": 157786,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026870": {
      "source_sha256": "5d002a428ee61fdd023bb276d1735ee0b05f6f0eac66b84ee72f2fade6171ebc",
      "text": "nothing looks familiar.",
      "source_offset": 157808,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:0002687e": {
      "source_sha256": "9fe36554971cf5320ffaa16d02503e38f2831db1cee51af7863535fdf21d5bd7",
      "text": "Anyway, how on earth",
      "source_offset": 157822,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:0002689a": {
      "source_sha256": "e82defa69060747eeed7ef606adc206035036c9dd643da87b46730098e6d5094",
      "text": "did I end up like this?",
      "source_offset": 157850,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000268b4": {
      "source_sha256": "e7dac9a5d34e0766c81e469e16283d2d974cb219f8ced5390f949255424acb63",
      "text": "I need to think back, step by step.",
      "source_offset": 157876,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000268ce": {
      "source_sha256": "9fe36554971cf5320ffaa16d02503e38f2831db1cee51af7863535fdf21d5bd7",
      "text": "Anyway, how on earth",
      "source_offset": 157902,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000268ea": {
      "source_sha256": "58bdaa1f7e6c7fc17e1d371e8aecbd895293968b213c83d4743b3bfa8e664dd3",
      "text": "did I end up like this?",
      "source_offset": 157930,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026902": {
      "source_sha256": "dfc197a1c42a69d501cd3489f34f8ec60b7b285ad7a01af39e8d7d580f36d6f8",
      "text": "Let's think back, step by step.",
      "source_offset": 157954,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:0002691a": {
      "source_sha256": "975ea8e61fd31d0caf7c6381bd62013e7804ea77d8bc63902c87872d07e13b7c",
      "text": "Let's see...",
      "source_offset": 157978,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:0002692a": {
      "source_sha256": "a43b97859ba6c9930770e51a9dff799e7d2b21b1e7852869613a30aa374e8dac",
      "text": "　About myself",
      "source_offset": 157994,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026938": {
      "source_sha256": "f2095c9c972ce06d340c86a9e526417e139c50bdf05f7be801e11c47a5a7ee1a",
      "text": "　Recent events",
      "source_offset": 158008,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026946": {
      "source_sha256": "519b7b48005c358eac304cf2face517d8b49535f76f4e21732366462a5b40705",
      "text": "　Trivial things",
      "source_offset": 158022,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026958": {
      "source_sha256": "998b8c1e55e6f2d1622e029eb2d103b88fa8b11df1269c721ac4e51cd4a9d0cd",
      "text": "I was born in the Empire.",
      "source_offset": 158040,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:0002696e": {
      "source_sha256": "f4b09102d3cd86bd56abbce301eccab93f8f159769bc315f43bb987b9cd07168",
      "text": "...Though, to be precise,",
      "source_offset": 158062,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026980": {
      "source_sha256": "0c02bd29c650ec6a3ef9165f1435f35e9f5121c9b63aa7dce3923d02800f9260",
      "text": "it was a small country village.",
      "source_offset": 158080,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026992": {
      "source_sha256": "a1978b9b81e8813093256f35635a5ced8aa5aef9b6a0e1a408ae3715c2877f05",
      "text": "I was born in the Empire.",
      "source_offset": 158098,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000269a8": {
      "source_sha256": "f4b09102d3cd86bd56abbce301eccab93f8f159769bc315f43bb987b9cd07168",
      "text": "...Though, to be precise,",
      "source_offset": 158120,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000269ba": {
      "source_sha256": "0c02bd29c650ec6a3ef9165f1435f35e9f5121c9b63aa7dce3923d02800f9260",
      "text": "it was a small country village.",
      "source_offset": 158138,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000269cc": {
      "source_sha256": "6331123fd95f7c08c240869451c6d039540524b7c246344133a914c130de1efd",
      "text": "Even though it was in the south,",
      "source_offset": 158156,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000269e2": {
      "source_sha256": "2ca97b5ecbb5127028d43d7b3bbeb8989f9b867e821a47eda9e3189ff9b7894f",
      "text": "snow would fall there in winter,",
      "source_offset": 158178,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000269f8": {
      "source_sha256": "88923b6017e1a2fe0879c6923bd374cccb0cb2ce882be6e65b1bb8941fd83af3",
      "text": "as I recall.",
      "source_offset": 158200,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    }
  }
}
