      "text": "Ugh...",
      "source_offset": 157398,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000266e4": {
      "source_sha256": "f324c2d1b8d45596bfabb13399de35eb6758adace9e3841410206a1e119627b7",
      "text": "Why am I lying",
      "source_offset": 157412,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000266fc": {
      "source_sha256": "64ae6019d71c19629b950f59e27b1d44779b8332407305b10bc5eabdcef0eebd",
      "text": "flat on my back on this beach?",
      "source_offset": 157436,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026714": {
      "source_sha256": "5284d111d643c9d51477ca36643e67067b2f345d4b7a09f303d87ef29966a8f6",
      "text": "No...",
      "source_offset": 157460,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026720": {
      "source_sha256": "d639e43517f8924ce00b6fce5ea471e0c94f95ac55ea7e6f9f90db65f9a62b37",
      "text": "Before that...",
      "source_offset": 157472,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026732": {
      "source_sha256": "36abbabb772ba21769038e917960eb77d14ee50a5fd414b1a57225d8eed003ed",
      "text": "Where am I???",
      "source_offset": 157490,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026748": {
      "source_sha256": "a0196084c785530d77de918e37d35d9a59fba4a464ac40d97017688ee9da6a4e",
      "text": "H-huh...",
      "source_offset": 157512,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026756": {
