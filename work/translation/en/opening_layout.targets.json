      "source_offset": 157110,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000265c2": {
      "source_sha256": "9dc5d2517381612ca874835b6f778ace2076cf36fad5c4f7f5ae3b57f8e9a12c",
      "text": "for me?",
      "source_offset": 157122,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000265d2": {
      "source_sha256": "25989ebc48b0d6e3e1adaf528660f11aadc69d580e6d05e17dc844ea90e49abd",
      "text": "But who? From where?",
      "source_offset": 157138,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:000265ec": {
      "source_sha256": "1bb7c988bc741e6abd6971f2d39eabec125d6c67ba5eca50b8b0370793f01d90",
      "text": "I've been waiting all this time",
      "source_offset": 157164,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026606": {
      "source_sha256": "11b8deed20187cecc88d380ca8606a546a2563991396dd2e4021ded600106b9a",
      "text": "for someone like you",
      "source_offset": 157190,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:0002661e": {
      "source_sha256": "6a58c03317491bd21bff2939d7dc2b868ece00d5505a952a3cb2384066789f1d",
      "text": "to come someday.",
      "source_offset": 157214,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026630": {
      "source_sha256": "1f5b485cd6c1bb241346ff8372e9b35a57f945c67e811bac89fc9c5c6394b3e6",
      "text": "For... me?",
      "source_offset": 157232,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026640": {
      "source_sha256": "6d5fbecb3cd52f4a3f86ae34b40981259aea20063854e0a66fed6e796656f9b8",
      "text": "For... me?",
      "source_offset": 157248,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
    "00:00065:text:00026654": {
      "source_sha256": "3810f107d96accda6f50bb91ccf0effdbc9ca7d221deb7448f9e07f6d5ef08d9",
      "text": "I'm sure you",
      "source_offset": 157268,
      "status": "meaning_reviewed",
      "encoding_profile": "dialogue_fullwidth_cp932"
    },
