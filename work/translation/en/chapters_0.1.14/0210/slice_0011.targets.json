    "00:00210:text:00002d88": {
      "resource_row": 26,
      "source_sha256": "af422b8a3025faa051b599574eea7f7aea163e1c952fee43b3c5da3533776fba",
      "source_offset": 11656,
      "source_byte_length": 30,
      "reference_instructions": [
        10784
      ],
      "text": "anywhere in this world."
    },
    "00:00210:text:00002da8": {
      "resource_row": 27,
      "source_sha256": "4aaecddb94c30fa22d5e1f2fcfb4e099ff3716737c01170c96b82ee707bbb4c3",
      "source_offset": 11688,
      "source_byte_length": 22,
      "reference_instructions": [
        10820
      ],
      "text": "Each person has ideals,"
    },
    "00:00210:text:00002dc0": {
      "resource_row": 28,
      "source_sha256": "b8222e534ec0417bec42a7aaa2e359d058edf7c3debf4e128dac6821a7736d80",
      "source_offset": 11712,
      "source_byte_length": 22,
      "reference_instructions": [
        10828
      ],
      "text": "convictions, and wishes of their own."
    },
    "00:00210:text:00002dd8": {
      "resource_row": 29,
      "source_sha256": "c9c680164102715e1fd39f96c587d6116ffe770a9329fad688ad38d68cd529db",
      "source_offset": 11736,
      "source_byte_length": 32,
      "reference_instructions": [
        10864
      ],
      "text": "Nothing is more precious"
    },
    "00:00210:text:00002dfa": {
      "resource_row": 30,
      "source_sha256": "bdf45b6ffe1e30ab6d2ce5211e23efba305f8566b71199536bda77e24626a6ad",
      "source_offset": 11770,
      "source_byte_length": 18,
      "reference_instructions": [
        10872
      ],
      "text": "than living true to them."
    },
    "00:00210:text:00002e0e": {
      "resource_row": 31,
      "source_sha256": "b7f278509cf6a0ac2495c7073c0c008ef6ca693a76835454cae42bf03486e88d",
      "source_offset": 11790,
      "source_byte_length": 20,
      "reference_instructions": [
        10908
      ],
      "text": "Though I borrowed those words"
    },
    "00:00210:text:00002e24": {
      "resource_row": 32,
      "source_sha256": "75ceeeda95a8a89f04a7dfc98bdd3fecc2901cf7720f0296698101ce2b2528a4",
      "source_offset": 11812,
      "source_byte_length": 18,
      "reference_instructions": [
        10916
      ],
      "text": "from Lady Misumi."
    },
    "00:00210:text:00002e38": {
      "resource_row": 33,
      "source_sha256": "14cd3d37701b14b936fa0a3aa200aafe9bf3940f3e8803200b3b77a252e43d09",
      "source_offset": 11832,
      "source_byte_length": 18,
      "reference_instructions": [
        10936
      ],
      "text": "So it's precious"
    },
    "00:00210:text:00002e4c": {
      "resource_row": 34,
      "source_sha256": "a13f481e22911b203a2c0e0c54fbc4ff1ae8d2547dca72e7e7643c0314456148",
      "source_offset": 11852,
      "source_byte_length": 14,
      "reference_instructions": [
        10944
      ],
      "text": "to refuse to give up..."
    }
