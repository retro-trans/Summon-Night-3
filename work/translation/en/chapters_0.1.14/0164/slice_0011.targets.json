    "00:00164:text:00002db4": {
      "resource_row": 21,
      "source_sha256": "51950e75e68a76fd931f655873e14f439430112fbf4e093df2aa3daad98befed",
      "source_offset": 11700,
      "source_byte_length": 22,
      "reference_instructions": [
        10720
      ],
      "text": "Protect my wife and unborn child."
    },
    "00:00164:text:00002dcc": {
      "resource_row": 22,
      "source_sha256": "f66b056873a4de87a8cb6f222353a8d5777ff2428d178932452b6f13bf01cb52",
      "source_offset": 11724,
      "source_byte_length": 26,
      "reference_instructions": [
        10728
      ],
      "text": "Take them home to Silturn."
    },
