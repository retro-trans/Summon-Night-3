      "source_offset": 13452,
      "source_byte_length": 8,
      "reference_instructions": [
        11736
      ],
      "text": "too, huh..."
    },
    "00:00190:text:00003496": {
      "resource_row": 68,
      "source_sha256": "794ddfd9816436ec17d22fd244e4c8a56e56e2ab01635294035e50242b6636fa",
      "source_offset": 13462,
      "source_byte_length": 18,
      "reference_instructions": [
        11752
      ],
      "text": "Can softness"
    },
    "00:00190:text:000034aa": {
