      "resource_row": 58,
      "source_sha256": "7a48076042ba04fd20fc59cbe32210d398ffd696703e018f23a61d4d3141d930",
      "source_offset": 13262,
      "source_byte_length": 18,
      "reference_instructions": [
        11524
      ],
      "text": "You can trust me on that."
    },
    "00:00190:text:000033e2": {
      "resource_row": 59,
      "source_sha256": "8e77d5e8973317c80ea2a03baa250cdb9d75d45aa7ec396631c06a21e289b011",
      "source_offset": 13282,
      "source_byte_length": 14,
      "reference_instructions": [
        11552
      ],
      "text": "Yafha..."
    },
    "00:00190:text:000033f2": {
      "resource_row": 60,
      "source_sha256": "008c54dbee26a0ea395062d2a54cea800bd9fd2bf3042cd4e633b7f103966296",
      "source_offset": 13298,
      "source_byte_length": 18,
      "reference_instructions": [
        11572
      ],
      "text": "Yafha..."
    },
    "00:00190:text:00003406": {
      "resource_row": 61,
      "source_sha256": "82c357d1dcdc3e1f705c9dacb9ede075fc536426cecfad450bd7f24c61fe48b9",
      "source_offset": 13318,
      "source_byte_length": 16,
      "reference_instructions": [
        11606
      ],
      "text": "Stay away from the ruins."
    },
    "00:00190:text:00003418": {
      "resource_row": 62,
      "source_sha256": "c7aba72e7f7bb7a14d295fdbcb974a9a5c44a9b673d167c608a2e1861e7f2d2f",
      "source_offset": 13336,
      "source_byte_length": 36,
      "reference_instructions": [
        11614
      ],
      "text": "And if you can, stop drawing that sword too."
    },
    "00:00190:text:0000343e": {
      "resource_row": 63,
      "source_sha256": "07b3ccf3ac15596c81245d6609d889cd0f0c342a7533c6a29f057f8e47570bbb",
      "source_offset": 13374,
      "source_byte_length": 20,
      "reference_instructions": [
        11648
      ],
      "text": "That's my advice..."
    },
    "00:00190:text:00003454": {
