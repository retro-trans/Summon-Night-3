      "source_sha256": "8e77d5e8973317c80ea2a03baa250cdb9d75d45aa7ec396631c06a21e289b011",
      "source_offset": 13396,
      "source_byte_length": 14,
      "reference_instructions": [
        11680
      ],
      "text": "Yafha..."
    },
    "00:00190:text:00003464": {
