      "source_offset": 11724,
      "source_byte_length": 10,
      "reference_instructions": [
        10512
      ],
      "text": "Hey, Teacher."
    },
    "00:00135:text:00002dd8": {
      "resource_row": 12,
      "source_sha256": "fd205b1b814c77295fa02ef0283a909c2d635416bee75b1d5ca45bc277cb6f97",
      "source_offset": 11736,
      "source_byte_length": 14,
      "reference_instructions": [
        10520
      ],
      "text": "Out for a nighttime stroll?"
    },
    "00:00135:text:00002de8": {
      "resource_row": 13,
      "source_sha256": "72565aecd4280b24eaa8a25706903476ffd8b77ecec411a64ad58ec072854677",
      "source_offset": 11752,
      "source_byte_length": 18,
      "reference_instructions": [
        10548
      ],
      "text": "Something like that."
    },
    "00:00135:text:00002dfc": {
      "resource_row": 14,
      "source_sha256": "92782c056d204419e56436afb4b4c219a488889165f1645662af9f024b0fa19b",
      "source_offset": 11772,
      "source_byte_length": 10,
      "reference_instructions": [
        10556
      ],
      "text": "How about you, Kyle?"
    },
    "00:00135:text:00002e08": {
      "resource_row": 15,
      "source_sha256": "de21f7e7932bde1fd1c4624fec962f40dae76794eed3cca77b3ef3e746e48779",
      "source_offset": 11784,
      "source_byte_length": 22,
      "reference_instructions": [
        10576
      ],
      "text": "Yes, something like that."
    },
    "00:00135:text:00002e20": {
      "resource_row": 16,
      "source_sha256": "cbdbc20edf22d69123aa8eeb0779a39a17d46c688c551c0409e8ce02099025fb",
      "source_offset": 11808,
      "source_byte_length": 14,
      "reference_instructions": [
        10584
      ],
      "text": "And you, Kyle?"
    },
    "00:00135:text:00002e30": {
      "resource_row": 17,
      "source_sha256": "9b43a06a3c4da16762136b1628a17cfa2f321f16e9c13621fd0395d590005d90",
      "source_offset": 11824,
      "source_byte_length": 14,
      "reference_instructions": [
        10618
      ],
      "text": "Oh, I was just"
    },
    "00:00135:text:00002e40": {
      "resource_row": 18,
      "source_sha256": "5dedf4cbbb22a30a2dbca3df921d4ea46f55cd6f4cdf381d8199b0f90ad252a1",
      "source_offset": 11840,
      "source_byte_length": 28,
      "reference_instructions": [
        10626
      ],
      "text": "thinking about the old days."
    },
    "00:00135:text:00002e5e": {
      "resource_row": 19,
      "source_sha256": "fe2ce6b2295a5d2484a7178919c5b64c88e067be5f0cbac4f9002b13cc2add51",
      "source_offset": 11870,
      "source_byte_length": 10,
      "reference_instructions": [
        10642
      ],
      "text": "The old days?"
    },
    "00:00135:text:00002e6a": {
      "resource_row": 20,
      "source_sha256": "c126d1878d19c7af94f73231664c8983ecd54b9653eafb30fd9e40814ca03ad1",
      "source_offset": 11882,
      "source_byte_length": 26,
      "reference_instructions": [
        10678
      ],
      "text": "Want to hear about it?"
    },
    "00:00135:text:00002e86": {
      "resource_row": 21,
      "source_sha256": "237db8ea1ddb6b797c43ea5e58fa0012eedaa18051d3ae32d86d788b2d2f4bba",
      "source_offset": 11910,
      "source_byte_length": 38,
      "reference_instructions": [
        10686
      ],
      "text": "How I became a pirate..."
    },
    "00:00135:text:00002eae": {
      "resource_row": 22,
      "source_sha256": "55df29238a94c5946b2d2778b9f4fa0c1b80ca2fefe9ed96df119482bcd41ab9",
      "source_offset": 11950,
      "source_byte_length": 24,
      "reference_instructions": [
        10722
      ],
      "text": "Ever since I was a kid,"
    },
    "00:00135:text:00002ec8": {
      "resource_row": 23,
      "source_sha256": "5d7d9ca08f1ad17cd8c088f0cf68579576b0deb606bab64f21f52fc052220570",
      "source_offset": 11976,
      "source_byte_length": 22,
      "reference_instructions": [
        10730
      ],
      "text": "I always loved the sea."
    },
    "00:00135:text:00002ee0": {
      "resource_row": 24,
      "source_sha256": "b6693e8418a995e535f5ee8df02e016a4e4f48ec7d285a952b8f51bde963064b",
      "source_offset": 12000,
      "source_byte_length": 24,
      "reference_instructions": [
        10750
      ],
      "text": "I wanted to know what lay beyond it,"
    },
    "00:00135:text:00002efa": {
      "resource_row": 25,
      "source_sha256": "d8207f17995828976fc14c9b882448bea2e948c0a47ab7421e4ba99bc1a5e6f6",
      "source_offset": 12026,
      "source_byte_length": 24,
      "reference_instructions": [
        10758
      ],
      "text": "to travel far, far away,"
    },
    "00:00135:text:00002f14": {
      "resource_row": 26,
      "source_sha256": "8f14cc383381c3bb0eae174b32852a40938a0ea007fdc2b9377080081c815e96",
      "source_offset": 12052,
      "source_byte_length": 22,
      "reference_instructions": [
        10766
      ],
      "text": "so I stowed away on a ship."
    },
    "00:00135:text:00002f2c": {
      "resource_row": 27,
      "source_sha256": "ceab4e2e2b17792beabd553b4d15750c6525247a30c0e55def26ba365a4a484f",
      "source_offset": 12076,
      "source_byte_length": 20,
      "reference_instructions": [
        10786
      ],
      "text": "Never even dreamed"
    },
    "00:00135:text:00002f42": {
      "resource_row": 28,
      "source_sha256": "8fdc1a4bfeb5a0cb7685a030befabc23d49823c05066ce7822c7ea351ae5e40e",
      "source_offset": 12098,
      "source_byte_length": 24,
      "reference_instructions": [
        10794
      ],
      "text": "it was a pirate ship."
    },
    "00:00135:text:00002f5c": {
      "resource_row": 29,
      "source_sha256": "403145ffd2c35a66cb53fcb7103e0e6620aa62a5b163aecac5851c5aef3b8c7c",
      "source_offset": 12124,
      "source_byte_length": 18,
      "reference_instructions": [
        10814
      ],
      "text": "Those rough seafarers"
    },
    "00:00135:text:00002f70": {
      "resource_row": 30,
      "source_sha256": "74d59c6b4fa41e330891ab08171736d1126e6c80bafe7d65e8dfc4589a5b35fa",
      "source_offset": 12144,
      "source_byte_length": 24,
      "reference_instructions": [
        10822
      ],
      "text": "didn't abandon that reckless kid."
    },
    "00:00135:text:00002f8a": {
      "resource_row": 31,
      "source_sha256": "042d73eb510c0f8a66fd6718a58acb80c21804d3dea943b33c2f9a31b4b5c9b6",
      "source_offset": 12170,
      "source_byte_length": 20,
      "reference_instructions": [
        10830
      ],
      "text": "They taught me the ways of the sea."
    },
    "00:00135:text:00002fa0": {
      "resource_row": 32,
      "source_sha256": "870d3e3d8b423a62924693e2650dfab5c4a77f60a6783e9ee25fb139d96e96a3",
      "source_offset": 12192,
      "source_byte_length": 20,
      "reference_instructions": [
        10850
      ],
      "text": "Before I knew it, this fisherman's brat"
    },
    "00:00135:text:00002fb6": {
      "resource_row": 33,
      "source_sha256": "29441784a0c4b11fac4d30668c439203f2c1b6efc6d53f57f1e7c6cc0a20f69b",
      "source_offset": 12214,
      "source_byte_length": 14,
      "reference_instructions": [
        10858
      ],
      "text": "had become"
    },
    "00:00135:text:00002fc6": {
      "resource_row": 34,
      "source_sha256": "d41f54f33de6540178d857054b24fceffc6d3c05f0e1b1ac080e793370bd9343",
      "source_offset": 12230,
      "source_byte_length": 8,
      "reference_instructions": [
        10866
      ],
      "text": "a pirate."
    },
    "00:00135:text:00002fd0": {
      "resource_row": 35,
      "source_sha256": "d9de41df68cecb32aa28f64d9d626be28f024b1032be5584a7bf2d6056861c60",
      "source_offset": 12240,
      "source_byte_length": 20,
      "reference_instructions": [
        10886
      ],
      "text": "Still chasing an old dream,"
    },
    "00:00135:text:00002fe6": {
      "resource_row": 36,
      "source_sha256": "1417a349294adc5673f89394256e91bbfdfa2562486cbad1a7d9700c6f64e047",
      "source_offset": 12262,
      "source_byte_length": 14,
      "reference_instructions": [
        10894
      ],
      "text": "living free"
    },
    "00:00135:text:00002ff6": {
      "resource_row": 37,
      "source_sha256": "6071507c63782d559d274de6b536d6a40e26a6b010a11135ca70f63335551bed",
      "source_offset": 12278,
      "source_byte_length": 14,
      "reference_instructions": [
        10902
      ],
      "text": "as a pirate..."
    },
    "00:00135:text:00003006": {
      "resource_row": 38,
      "source_sha256": "0e822524ebf3f6067b948a950a734c8f425574e04de970a16cab7520cff42f40",
      "source_offset": 12294,
      "source_byte_length": 10,
      "reference_instructions": [
        10956
      ],
      "text": "Oh, Teacher."
    },
    "00:00135:text:00003012": {
      "resource_row": 39,
      "source_sha256": "968ae1b18926d238466bf3d938b7f7502b4a6b5222eb6d535287667c5bc00232",
      "source_offset": 12306,
      "source_byte_length": 18,
      "reference_instructions": [
        10964
      ],
      "text": "Out for a walk?"
    },
    "00:00135:text:00003026": {
      "resource_row": 40,
      "source_sha256": "72565aecd4280b24eaa8a25706903476ffd8b77ecec411a64ad58ec072854677",
      "source_offset": 12326,
      "source_byte_length": 18,
      "reference_instructions": [
        10992
      ],
      "text": "Something like that."
    },
    "00:00135:text:0000303a": {
      "resource_row": 41,
      "source_sha256": "f2bf2832542a0189bc9efa269a7e158a70bfbf4dd44da830137701953db960fd",
      "source_offset": 12346,
      "source_byte_length": 10,
      "reference_instructions": [
        11000
      ],
      "text": "How about you, Sonolar?"
    },
    "00:00135:text:00003046": {
      "resource_row": 42,
      "source_sha256": "de21f7e7932bde1fd1c4624fec962f40dae76794eed3cca77b3ef3e746e48779",
      "source_offset": 12358,
      "source_byte_length": 22,
      "reference_instructions": [
        11020
      ],
      "text": "Yes, something like that."
    },
    "00:00135:text:0000305e": {
      "resource_row": 43,
      "source_sha256": "f2bf2832542a0189bc9efa269a7e158a70bfbf4dd44da830137701953db960fd",
      "source_offset": 12382,
      "source_byte_length": 10,
      "reference_instructions": [
        11028
      ],
      "text": "How about you, Sonolar?"
    },
    "00:00135:text:0000306a": {
      "resource_row": 44,
      "source_sha256": "00dd1112aa116d758b51bfbd02f4c9c710e09d7385c6a1ab95dd80674e0ad393",
      "source_offset": 12394,
      "source_byte_length": 16,
      "reference_instructions": [
        11064
      ],
      "text": "Yeah, I was just"
    },
    "00:00135:text:0000307c": {
      "resource_row": 45,
      "source_sha256": "1a4e3c213a439271a6aa6746538ea5b3933f6d47ab3c8561e763fc5efdb2c51c",
      "source_offset": 12412,
      "source_byte_length": 36,
      "reference_instructions": [
        11072
      ],
      "text": "thinking about the old days..."
    },
    "00:00135:text:000030a2": {
      "resource_row": 46,
      "source_sha256": "fe2ce6b2295a5d2484a7178919c5b64c88e067be5f0cbac4f9002b13cc2add51",
      "source_offset": 12450,
      "source_byte_length": 10,
      "reference_instructions": [
        11088
      ],
      "text": "The old days?"
    },
    "00:00135:text:000030ae": {
      "resource_row": 47,
      "source_sha256": "45beaa1eccf3559f122b3c9fd411f411d78517b2ef6e03b500e4c048e4847309",
      "source_offset": 12462,
      "source_byte_length": 38,
      "reference_instructions": [
        11124
      ],
      "text": "Will you listen to my story?"
    },
    "00:00135:text:000030d6": {
      "resource_row": 48,
      "source_sha256": "e7dbae8cce5e0641b513b82778f547c993017bf80fbcdfe570196057992cab12",
      "source_offset": 12502,
      "source_byte_length": 30,
      "reference_instructions": [
        11132
      ],
      "text": "How I became a pirate..."
    },
    "00:00135:text:000030f6": {
      "resource_row": 49,
      "source_sha256": "107697d848b9dac146ff54efe115675ccaca3cf7d5902e8eac7318e18f950174",
      "source_offset": 12534,
      "source_byte_length": 22,
      "reference_instructions": [
        11168
      ],
      "text": "My earliest memory..."
    },
    "00:00135:text:0000310e": {
      "resource_row": 50,
      "source_sha256": "6b8d492b9f17c35e26bb76a05c53f3748433f9523b58120af82fd16343a8b565",
      "source_offset": 12558,
      "source_byte_length": 16,
      "reference_instructions": [
        11188
      ],
      "text": "Cold water and a dark wind."
    },
    "00:00135:text:00003120": {
      "resource_row": 51,
      "source_sha256": "ef5c579ad50e299a258842fd40fba22be212b15f636dcee6c976d83e07986f0e",
      "source_offset": 12576,
      "source_byte_length": 18,
      "reference_instructions": [
        11196
      ],
      "text": "The harsh, bitter taste of salt."
    },
    "00:00135:text:00003134": {
      "resource_row": 52,
      "source_sha256": "ea0d181c7a363a2749ee1a408e0c365d0cf664aba3ce651348b34fd06901d476",
      "source_offset": 12596,
      "source_byte_length": 18,
      "reference_instructions": [
        11216
      ],
      "text": "I thought I was going to"
    },
    "00:00135:text:00003148": {
      "resource_row": 53,
      "source_sha256": "7d630b9050eea787cd9208ed5fd2a1bc5c863c70dfae544f9cb70c2208138dc4",
      "source_offset": 12616,
      "source_byte_length": 20,
      "reference_instructions": [
        11224
      ],
      "text": "sink into the sea."
    },
    "00:00135:text:0000315e": {
      "resource_row": 54,
      "source_sha256": "885ea055a033965842a6d5f7e21ddc2e11d8392433046cb53d873c3adfbbf079",
      "source_offset": 12638,
      "source_byte_length": 22,
      "reference_instructions": [
        11232
      ],
      "text": "I was so little then."
    },
    "00:00135:text:00003176": {
      "resource_row": 55,
      "source_sha256": "6aedf3cbd75c461f35e78d83c8e64edd430b38473243f9a1a53f4186541402b7",
      "source_offset": 12662,
      "source_byte_length": 18,
      "reference_instructions": [
        11252
      ],
      "text": "I closed my eyes."
    },
    "00:00135:text:0000318a": {
      "resource_row": 56,
      "source_sha256": "f5acbea7528e409670ac7c8d2f9877be75f4f7cfbd889d97386e0e6a1f726c37",
      "source_offset": 12682,
      "source_byte_length": 22,
      "reference_instructions": [
        11260
      ],
      "text": "Just as my strength was giving out,"
    },
    "00:00135:text:000031a2": {
      "resource_row": 57,
      "source_sha256": "da446612a3b1e74bb0f63ea38e56166f2a9f174afb8dee1fb7c5cb70428307c0",
      "source_offset": 12706,
      "source_byte_length": 20,
      "reference_instructions": [
        11268
      ],
      "text": "someone grabbed my hand."
    },
    "00:00135:text:000031b8": {
      "resource_row": 58,
      "source_sha256": "82e88302ecf5e3d53684ad70bc1266f70fc7934201fe8f4eb32435ef67f2180a",
      "source_offset": 12728,
      "source_byte_length": 24,
      "reference_instructions": [
        11288
      ],
      "text": "It didn't matter to me"
    },
    "00:00135:text:000031d2": {
      "resource_row": 59,
      "source_sha256": "192a2aebe79e65f9f55dc0b485ee69b4537424e017f6187a867a450a70277686",
      "source_offset": 12754,
      "source_byte_length": 22,
      "reference_instructions": [
        11296
      ],
      "text": "that the person was a pirate captain."
    },
    "00:00135:text:000031ea": {
      "resource_row": 60,
      "source_sha256": "b43c8390016f19a3337e278f9ef285adaf816f32e2abf4c94679d7b74f5f92f2",
      "source_offset": 12778,
      "source_byte_length": 24,
      "reference_instructions": [
        11316
      ],
      "text": "Mom and Dad had sunk beneath the waves."
    },
    "00:00135:text:00003204": {
      "resource_row": 61,
      "source_sha256": "750c783dc36f7f8051ffe24d5513c8f16cd13c6d33b48b8b0cb5317cd64d8419",
      "source_offset": 12804,
      "source_byte_length": 24,
      "reference_instructions": [
        11324
      ],
      "text": "I was all alone,"
    },
    "00:00135:text:0000321e": {
      "resource_row": 62,
      "source_sha256": "2849f13b150fd6a62b985995ea61af865cd80314d3421ce87cbbd624ce0ef229",
      "source_offset": 12830,
      "source_byte_length": 20,
      "reference_instructions": [
        11332
      ],
      "text": "and everyone became my new family."
    },
    "00:00135:text:00003234": {
      "resource_row": 63,
      "source_sha256": "0e11350305a01c31818de1c0fcdd6501f5a81a58e7469939643d3a524aaafe3d",
      "source_offset": 12852,
      "source_byte_length": 20,
      "reference_instructions": [
        11352
      ],
      "text": "I wanted to stay with them forever."
    },
    "00:00135:text:0000324a": {
      "resource_row": 64,
      "source_sha256": "d0c01b35fd5078eec707a96df6735236fed5af5320729ec3de79a9e9ed0a2449",
      "source_offset": 12874,
      "source_byte_length": 24,
      "reference_instructions": [
        11360
      ],
      "text": "I couldn't bear to leave them."
    },
    "00:00135:text:00003264": {
      "resource_row": 65,
      "source_sha256": "a8c6aaac3d69b61e6a4e42f276e5dbae8d72e1c4cdf3940b8ca842c871252387",
      "source_offset": 12900,
      "source_byte_length": 12,
      "reference_instructions": [
        11368
      ],
      "text": "That's why..."
    },
    "00:00135:text:00003272": {
      "resource_row": 66,
      "source_sha256": "415684d67a414cbd0cd2b5f2ba3e7678d199bbf7c7f2544054b249c462d45402",
      "source_offset": 12914,
      "source_byte_length": 20,
      "reference_instructions": [
        11388
      ],
      "text": "That's why I'm"
    },
    "00:00135:text:00003288": {
      "resource_row": 67,
      "source_sha256": "6889bf4c5acd5f62d50454aacc3a9bad3283eb34bf6cfc8ae5a63351599eff58",
      "source_offset": 12936,
      "source_byte_length": 16,
      "reference_instructions": [
        11396
      ],
      "text": "here today..."
    }
  }
}
