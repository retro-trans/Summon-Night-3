      "source_offset": 13382,
      "source_byte_length": 8,
      "reference_instructions": [
        11624
      ],
      "text": "She said..."
    },
    "00:00189:text:00003450": {
      "resource_row": 68,
      "source_sha256": "062fc848d27446236fcbe4b3cfa6b1486206bddc11fd3d82ca583acf9fedf097",
      "source_offset": 13392,
      "source_byte_length": 18,
      "reference_instructions": [
        11640
      ],
