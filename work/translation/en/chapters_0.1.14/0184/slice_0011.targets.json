  "translations": {
    "00:00184:text:00002d22": {
      "resource_row": 11,
      "source_sha256": "aee8851c3f6d00c93ece6f6254a01e8b7fa1e5fdf9ef0f665f4f43f786626402",
      "source_offset": 11554,
      "source_byte_length": 20,
      "reference_instructions": [
        10488
      ],
      "text": "▲, you've been talking"
    },
    "00:00184:text:00002d38": {
      "resource_row": 12,
      "source_sha256": "36aa502b2afc9811a175a0abeb32c17a4dc1e8e980c15a4965d5802ceab5c235",
      "source_offset": 11576,
      "source_byte_length": 32,
      "reference_instructions": [
        10496
      ],
      "text": "with everyone more lately, haven't you?"
    },
    "00:00184:text:00002d5a": {
      "resource_row": 13,
      "source_sha256": "aee8851c3f6d00c93ece6f6254a01e8b7fa1e5fdf9ef0f665f4f43f786626402",
      "source_offset": 11610,
      "source_byte_length": 20,
      "reference_instructions": [
        10516
      ],
      "text": "▲, you've been talking"
    },
    "00:00184:text:00002d70": {
      "resource_row": 14,
      "source_sha256": "f1b6d8404a0ed493bb7b6ea25a0b290ce46b990a11f6becf24f16c6aac23a3e7",
      "source_offset": 11632,
      "source_byte_length": 32,
      "reference_instructions": [
        10524
      ],
      "text": "with everyone more lately, haven't you?"
    },
    "00:00184:text:00002d92": {
      "resource_row": 15,
      "source_sha256": "e031c5a137a606a955af7dbd1763c696ce2fee08587f8cfd6de4f8f7a153f58d",
      "source_offset": 11666,
      "source_byte_length": 16,
      "reference_instructions": [
        10560
      ],
      "text": "Yes, but..."
    },
    "00:00184:text:00002da4": {
      "resource_row": 16,
      "source_sha256": "69f4980d540104795f281240ab2c6ecf34fb6ffa98f6fa18b67c6370f1e956a6",
      "source_offset": 11684,
      "source_byte_length": 26,
      "reference_instructions": [
        10596
      ],
      "text": "I'm still nowhere near"
    },
    "00:00184:text:00002dc0": {
      "resource_row": 17,
      "source_sha256": "c79f14120c11673d59de08e64ec1ab15ea4ac53a91101a738ca792229e0c0673",
      "source_offset": 11712,
      "source_byte_length": 32,
      "reference_instructions": [
        10604
      ],
      "text": "as good at conversation as you, Teacher."
    },
    "00:00184:text:00002de2": {
      "resource_row": 18,
      "source_sha256": "3b17bcad6b9a7690339f42a2a58c18117929b43fd5327c53cdda331c6f29e202",
      "source_offset": 11746,
      "source_byte_length": 32,
      "reference_instructions": [
        10640
      ],
      "text": "Either I only talk about myself,"
    },
    "00:00184:text:00002e04": {
      "resource_row": 19,
      "source_sha256": "e7da1477378ac122753e55911de5166fba570c35e8528f1741e4305155200d7d",
      "source_offset": 11780,
      "source_byte_length": 32,
      "reference_instructions": [
        10648
      ],
      "text": "or I just sit and listen."
    },
    "00:00184:text:00002e26": {
      "resource_row": 20,
      "source_sha256": "fadc268accfdff78c4b89461839119889c9ad8abcf81716f7e2bd991ab7e9b61",
      "source_offset": 11814,
      "source_byte_length": 20,
      "reference_instructions": [
        10684
      ],
      "text": "I try to be careful,"
    },
    "00:00184:text:00002e3c": {
      "resource_row": 21,
      "source_sha256": "09fbfb48c24df6a832117b774e8d7c99e7d173848027a3d5dac582a062279e90",
      "source_offset": 11836,
      "source_byte_length": 20,
      "reference_instructions": [
        10692
      ],
      "text": "but it keeps happening."
    },
    "00:00184:text:00002e52": {
      "resource_row": 22,
      "source_sha256": "23784360fcd955a58eb1c247f7cf3036ac5242ea63450b5f97d60429fafcdae1",
      "source_offset": 11858,
      "source_byte_length": 20,
      "reference_instructions": [
        10728
      ],
      "text": "I can't seem"
    },
    "00:00184:text:00002e68": {
      "resource_row": 23,
      "source_sha256": "518f1a08d673d46b36c4a07a4608d763498bbc3651971102ef25e831fb24c00f",
      "source_offset": 11880,
      "source_byte_length": 16,
      "reference_instructions": [
        10736
      ],
      "text": "to do both at once..."
    },
    "00:00184:text:00002e7a": {
      "resource_row": 24,
      "source_sha256": "92b78b123fe2f4911a90c62f82c9584bc3d120f46c8b05e0a379df3514046717",
      "source_offset": 11898,
      "source_byte_length": 16,
      "reference_instructions": [
        10772
      ],
      "text": "U-um..."
    },
    "00:00184:text:00002e8c": {
      "resource_row": 25,
      "source_sha256": "43d5a9686e496074208b3bb88a6ee3d251056d285e0f9c1bdcb5d69ba64ac2d8",
      "source_offset": 11916,
      "source_byte_length": 38,
      "reference_instructions": [
        10780
      ],
      "text": "Is it just me?"
    },
    "00:00184:text:00002eb4": {
      "resource_row": 26,
      "source_sha256": "5832f2e442b7b77b8fd20270385eccf271ef800f592cb33371d391bc49aefe8e",
      "source_offset": 11956,
      "source_byte_length": 34,
      "reference_instructions": [
        10816
      ],
      "text": "Do normal people never worry"
    },
    "00:00184:text:00002ed8": {
      "resource_row": 27,
      "source_sha256": "3bf68b12483c815531cd9b7268cb3b6fdc665b742418afb0ba9e727a95b88e24",
      "source_offset": 11992,
      "source_byte_length": 42,
      "reference_instructions": [
        10824
      ],
      "text": "about something so obvious?!"
    },
    "00:00184:text:00002f04": {
      "resource_row": 28,
      "source_sha256": "dcc4e1c4c7e07ba3cee86e804b3357a4a6f41788ee933dba2385737d7a733576",
      "source_offset": 12036,
      "source_byte_length": 16,
      "reference_instructions": [
        10852
      ],
      "text": "Not at all."
    },
    "00:00184:text:00002f16": {
      "resource_row": 29,
      "source_sha256": "d9881562776b95da286e8f19b9a6107efea8c676038b0f2d462797297bac6ec2",
      "source_offset": 12054,
      "source_byte_length": 28,
      "reference_instructions": [
        10860
      ],
      "text": "Everyone's like that at first."
    },
    "00:00184:text:00002f34": {
      "resource_row": 30,
      "source_sha256": "c656717ecbb9b4580b89bdd38172aaa967692ec827b8b722959503947ab17fa3",
      "source_offset": 12084,
      "source_byte_length": 18,
      "reference_instructions": [
        10880
      ],
      "text": "Not at all."
    },
    "00:00184:text:00002f48": {
      "resource_row": 31,
      "source_sha256": "ac152de48789c468255b124226eaebd24b799bec9323a184af554ff05dbd2018",
      "source_offset": 12104,
      "source_byte_length": 32,
      "reference_instructions": [
        10888
      ],
      "text": "Everyone's like that at first."
    },
    "00:00184:text:00002f6a": {
      "resource_row": 32,
      "source_sha256": "b504226b2efa0e7d6ff95ff0bdda61941278a1ef76c7a1bc7cdf31821cc065aa",
      "source_offset": 12138,
      "source_byte_length": 36,
      "reference_instructions": [
        10916
      ],
      "text": "When I was little, I was terribly shy about speaking."
    },
    "00:00184:text:00002f90": {
      "resource_row": 33,
      "source_sha256": "8cd2daf8ce98ae78c6c237360780b28203036bfd88151840312d8331eaaeadb3",
      "source_offset": 12176,
      "source_byte_length": 36,
      "reference_instructions": [
        10924
      ],
      "text": "I couldn't say even half of what I wanted to."
    },
    "00:00184:text:00002fb6": {
      "resource_row": 34,
      "source_sha256": "c80c1ce710270f210b6be856bece7186f932007296b85f37825f148fb6b46cc1",
      "source_offset": 12214,
      "source_byte_length": 8,
      "reference_instructions": [
        10958
      ],
      "text": "You, Teacher?"
    },
    "00:00184:text:00002fc0": {
      "resource_row": 35,
      "source_sha256": "54f033348275741994b11b30a71bb28fc7fbc9a27997354de84b556af011e996",
      "source_offset": 12224,
      "source_byte_length": 12,
      "reference_instructions": [
        10974
      ],
      "text": "Yes. So there's"
    },
    "00:00184:text:00002fce": {
      "resource_row": 36,
      "source_sha256": "f7b5dc5137e20fd1a2ffdd510267e991ffb14279473cb733983fad8c327b7e95",
      "source_offset": 12238,
      "source_byte_length": 20,
      "reference_instructions": [
        10982
      ],
      "text": "no need to worry."
    },
    "00:00184:text:00002fe4": {
      "resource_row": 37,
      "source_sha256": "6da3fb754dbee4bde48a20d9c0406db94bc278c91113e29f2d04b66a327783e3",
      "source_offset": 12260,
      "source_byte_length": 40,
      "reference_instructions": [
        11010
      ],
      "text": "Besides, wanting to talk to someone"
    },
    "00:00184:text:0000300e": {
      "resource_row": 38,
      "source_sha256": "6181448d6aecb6aae6478f0b41a6242b6e6d6bba2ad1c19551e38b8c9c116f1a",
      "source_offset": 12302,
      "source_byte_length": 28,
      "reference_instructions": [
        11018
      ],
      "text": "matters more than being good at it."
    },
    "00:00184:text:0000302c": {
      "resource_row": 39,
      "source_sha256": "6da3fb754dbee4bde48a20d9c0406db94bc278c91113e29f2d04b66a327783e3",
      "source_offset": 12332,
      "source_byte_length": 40,
      "reference_instructions": [
        11038
      ],
      "text": "Besides, isn't wanting to talk to someone"
    },
    "00:00184:text:00003056": {
      "resource_row": 40,
      "source_sha256": "c9fc678bbe06f3faa5e26b08aef26c70a01083a2eb29ef775a46fa5cd36f943c",
      "source_offset": 12374,
      "source_byte_length": 34,
      "reference_instructions": [
        11046
      ],
      "text": "more important than being good at it?"
    },
    "00:00184:text:0000307a": {
      "resource_row": 41,
      "source_sha256": "fcd6ae3fb352b3ba51f3bba3d20fde2dd6445c0ff29c801ccbdca2da832d6019",
      "source_offset": 12410,
      "source_byte_length": 28,
      "reference_instructions": [
        11062
      ],
      "text": "If you stop talking to people,"
    },
    "00:00184:text:00003098": {
      "resource_row": 42,
      "source_sha256": "933a04c97d51b5fe12a0287afc647b630b158dc00c1e34991383150979efe577",
      "source_offset": 12440,
      "source_byte_length": 20,
      "reference_instructions": [
        11070
      ],
      "text": "you can't move forward."
    },
    "00:00184:text:000030ae": {
      "resource_row": 43,
      "source_sha256": "8ac93f0a7e6c3c77ce4a39b01916d7523b3ba323e21b81ed6783268f342974fa",
      "source_offset": 12462,
      "source_byte_length": 20,
      "reference_instructions": [
        11098
      ],
      "text": "That's what I believe."
    },
    "00:00184:text:000030c4": {
      "resource_row": 44,
      "source_sha256": "ec7aece547e6fef23bbee647b1783b7c88f48c0e690eeef6ec283921654bed58",
      "source_offset": 12484,
      "source_byte_length": 18,
      "reference_instructions": [
        11118
      ],
      "text": "That's what I believe."
    },
    "00:00184:text:000030d8": {
      "resource_row": 45,
      "source_sha256": "0c9ab1043dfefb6fc37198ed865599cc8e4d8b3b961ff92042722743ef08eea1",
      "source_offset": 12504,
      "source_byte_length": 18,
      "reference_instructions": [
        11154
      ],
      "text": "Y-you're right, aren't you?"
    },
    "00:00184:text:000030ec": {
      "resource_row": 46,
      "source_sha256": "b8554318936c983be4072c2ac026d96fb877064e51feead5b89e9bc3eebe799e",
      "source_offset": 12524,
      "source_byte_length": 18,
      "reference_instructions": [
        11182
      ],
      "text": "Yes, absolutely."
    },
    "00:00184:text:00003100": {
      "resource_row": 47,
      "source_sha256": "1413fa4871c4a67d0bfbd28f27b75bcae7ee05a0a9c37401c815fef806700890",
      "source_offset": 12544,
      "source_byte_length": 16,
      "reference_instructions": [
        11202
      ],
      "text": "Keep talking,"
    },
    "00:00184:text:00003112": {
      "resource_row": 48,
      "source_sha256": "24bbc309091a195bfd76378d8e385ed90dd06bd692e327e5b7148dad2cb43cc8",
      "source_offset": 12562,
      "source_byte_length": 20,
      "reference_instructions": [
        11210
      ],
      "text": "and those worries"
    },
    "00:00184:text:00003128": {
      "resource_row": 49,
      "source_sha256": "a5bf83e944af521cb043ea6959b0f34c3735f2d41e1c201b5cfcd7dabc7ce0c3",
      "source_offset": 12584,
      "source_byte_length": 20,
      "reference_instructions": [
        11218
      ],
      "text": "will fade on their own."
    },
    "00:00184:text:0000313e": {
      "resource_row": 50,
      "source_sha256": "098efe6e4a90aa3f38edd755c311eccb553d4fa3b17c89c736fc052d95ab02dc",
      "source_offset": 12606,
      "source_byte_length": 16,
      "reference_instructions": [
        11226
      ],
      "text": "Keep trying..."
    }
  }
}
