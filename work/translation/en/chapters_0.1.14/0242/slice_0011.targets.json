      "resource_row": 31,
      "source_sha256": "4deed4ab3bb8804e70d79d337c1e05df20914e0db6e60c6c1d060a95a366758a",
      "source_offset": 12054,
      "source_byte_length": 34,
      "reference_instructions": [
        10966
      ],
      "text": "are just as anxious."
    },
    "00:00242:text:00002f3a": {
      "resource_row": 32,
      "source_sha256": "bcc5ceabd99d78d9841e78c64ac9a827163164812327f3fb5ddb359d92de4485",
      "source_offset": 12090,
      "source_byte_length": 8,
      "reference_instructions": [
        10982
      ],
      "text": "...!"
    },
