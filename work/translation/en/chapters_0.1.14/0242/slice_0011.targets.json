      "resource_row": 33,
      "source_sha256": "228c49dcca0ac887f0c92dac09f9274108faf61cdf85366311e389b5b7029442",
      "source_offset": 12100,
      "source_byte_length": 32,
      "reference_instructions": [
        11018
      ],
      "text": "When my husband went far away,"
