      "resource_row": 37,
      "source_sha256": "7859dde8e1ffa88106f8429e7123d295df0f43bb603769883093045a02e4a6d4",
      "source_offset": 12244,
      "source_byte_length": 18,
      "reference_instructions": [
        11104
      ],
      "text": "Never again"
    },
    "00:00242:text:00002fe8": {
      "resource_row": 38,
      "source_sha256": "88151af5d032df099cf918885bd0978a0d1646fa00102da59afda178df11b0ee",
      "source_offset": 12264,
      "source_byte_length": 18,
      "reference_instructions": [
        11112
      ],
      "text": "do I want to feel that way!"
    },
    "00:00242:text:00002ffc": {
      "resource_row": 39,
      "source_sha256": "6623b98d841fb3339c3621ec539f0ad5c715dfd90228056a7d1be5553f279de4",
      "source_offset": 12284,
      "source_byte_length": 40,
      "reference_instructions": [
        11146
      ],
      "text": "So I will fight beside you."
    },
    "00:00242:text:00003026": {
      "resource_row": 40,
      "source_sha256": "38bfefb86c5e7e35c10cc3845f76e4a4b78b2496da6d78c043b1e72eb8026189",
      "source_offset": 12326,
      "source_byte_length": 36,
      "reference_instructions": [
        11154
      ],
      "text": "This time, I'll protect you with my own hands."
    },
    "00:00242:text:0000304c": {
      "resource_row": 41,
      "source_sha256": "34cd0fc08a63be32cdda3f91d50dc1fce0807361b7ce45f82a6a4dc9f5dc00ec",
      "source_offset": 12364,
      "source_byte_length": 14,
      "reference_instructions": [
        11178
      ],
      "text": "So that I have"
    },
    "00:00242:text:0000305c": {
      "resource_row": 42,
      "source_sha256": "8fa132534b67d6c038d15aea9a4ed1677af44f1969e5c2b784ca628258d54543",
      "source_offset": 12380,
      "source_byte_length": 16,
      "reference_instructions": [
        11186
      ],
      "text": "no regrets..."
    },
    "00:00242:text:0000306e": {
      "resource_row": 43,
      "source_sha256": "f405603833031f7c279ee19c7d477aa77519a49dd4aa53d9ff725f96e9491a1e",
      "source_offset": 12398,
      "source_byte_length": 20,
      "reference_instructions": [
        11240
      ],
      "text": "I can't stop her"
    },
    "00:00242:text:00003084": {
      "resource_row": 44,
      "source_sha256": "43983d32c39f6605da124f10536f69b74e5d10c599acc1a587960ceaf87463fe",
      "source_offset": 12420,
      "source_byte_length": 20,
      "reference_instructions": [
        11248
      ],
      "text": "after seeing"
    },
    "00:00242:text:0000309a": {
      "resource_row": 45,
      "source_sha256": "8091065189747dc8e12e92e1650cfad43960042d8e17fcd3e371942f202b7c0c",
      "source_offset": 12442,
      "source_byte_length": 18,
      "reference_instructions": [
        11256
      ],
      "text": "such firm resolve..."
    },
    "00:00242:text:000030ae": {
      "resource_row": 46,
      "source_sha256": "61d3b3448c17130cc93dc58ffd3e27e2f41c828c1518687461320f083a14d3f0",
      "source_offset": 12462,
      "source_byte_length": 22,
      "reference_instructions": [
        11272
      ],
      "text": "I can't stop her."
    },
    "00:00242:text:000030c6": {
      "resource_row": 47,
      "source_sha256": "3a810e38437d5dbb1e720f95d90dc7387c1ba1f4cfa08f1ee0d9af8c3ec2715e",
      "source_offset": 12486,
      "source_byte_length": 18,
      "reference_instructions": [
        11280
      ],
      "text": "I understand those feelings"
    },
    "00:00242:text:000030da": {
      "resource_row": 48,
      "source_sha256": "744dd348c7242474835f8d33d247c796382a11225c791d639b8c71387cb9ac64",
      "source_offset": 12506,
      "source_byte_length": 22,
      "reference_instructions": [
        11288
      ],
      "text": "myself..."
    }
  }
