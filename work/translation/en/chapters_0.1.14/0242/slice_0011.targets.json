      "resource_row": 30,
      "source_sha256": "c3dfa4d8291969a7a20b2a68d3bae0a2ecdff23395d121633bd9bdb00cf29cbd",
      "source_offset": 12016,
      "source_byte_length": 36,
      "reference_instructions": [
        10958
      ],
      "text": "But those of us left waiting"
    },
