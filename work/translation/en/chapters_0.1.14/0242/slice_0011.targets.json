      "resource_row": 35,
      "source_sha256": "2d7818e3a82bcb5559aa6551da5d4db9128735912c89360b10d8930381262558",
      "source_offset": 12172,
      "source_byte_length": 40,
      "reference_instructions": [
        11062
      ],
      "text": "If I'd gone with him, perhaps I could have saved him..."
    },
    "00:00242:text:00002fb6": {
      "resource_row": 36,
      "source_sha256": "82f7fbb89e93528591eef22eaf3b412bb256941284cfdf0a02c7d84ee449fa02",
      "source_offset": 12214,
      "source_byte_length": 28,
      "reference_instructions": [
        11070
      ],
      "text": "I still think that."
    },
