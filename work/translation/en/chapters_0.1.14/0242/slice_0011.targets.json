    "00:00242:text:00002e1a": {
      "resource_row": 18,
      "source_sha256": "ec4ba55423af8037a77361dbb7a6418843cd4097323789439d44653a22ed6507",
      "source_offset": 11802,
      "source_byte_length": 16,
      "reference_instructions": [
        10622
      ],
      "text": "sorry."
    },
    "00:00242:text:00002e2c": {
      "resource_row": 19,
