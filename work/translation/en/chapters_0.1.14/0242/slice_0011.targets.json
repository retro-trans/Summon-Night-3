      "source_offset": 11862,
      "source_byte_length": 2,
      "reference_instructions": [
        10780
      ],
      "text": "●"
    },
    "00:00242:text:00002e5a": {
      "resource_row": 23,
      "source_sha256": "5f0c44854e2a7a01eebbc267563a5fc20a8da61e428bf9c15ad63ec167654a06",
      "source_offset": 11866,
      "source_byte_length": 18,
      "reference_instructions": [
        10788
      ],
      "text": "I've made my decision."
    },
    "00:00242:text:00002e6e": {
      "resource_row": 24,
      "source_sha256": "c6f9ec9f71d0d7152549ea0c2036dcca755ae51b2b78a1f7d1ddb55435a982ae",
      "source_offset": 11886,
      "source_byte_length": 18,
      "reference_instructions": [
        10822
      ],
      "text": "From now on,"
    },
    "00:00242:text:00002e82": {
      "resource_row": 25,
      "source_sha256": "821fa69acbe7e52894c298801079fa150297526e86f58cff4aa670e8db6e0d1e",
      "source_offset": 11906,
      "source_byte_length": 20,
      "reference_instructions": [
        10830
      ],
      "text": "I will fight alongside you."
    },
    "00:00242:text:00002e98": {
      "resource_row": 26,
      "source_sha256": "da2a99338d0f54b49f28cb15ba352e749ea8aa1a2c556a97256c2b7522aab680",
      "source_offset": 11928,
      "source_byte_length": 14,
      "reference_instructions": [
        10858
      ],
      "text": "Wh-?!"
