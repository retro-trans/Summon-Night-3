      "source_offset": 13432,
      "source_byte_length": 16,
      "reference_instructions": [
        11344
      ],
      "text": "I see..."
    },
    "00:00181:text:0000348a": {
      "resource_row": 36,
      "source_sha256": "8090fc1ce32a7d212257e27e5258b42759d40380b944a3a02565d6a690b0a9c7",
      "source_offset": 13450,
      "source_byte_length": 24,
      "reference_instructions": [
        11360
      ],
      "text": "Really, I think you ought"
