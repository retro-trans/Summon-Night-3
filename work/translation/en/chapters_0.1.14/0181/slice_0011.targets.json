      "resource_row": 51,
      "source_sha256": "5b79cddbe82e4a8bed40c068ba1a4dbfbb014333f1d973308f3dd8f833721531",
      "source_offset": 13776,
      "source_byte_length": 20,
      "reference_instructions": [
        11594
      ],
      "text": "continue looking after me."
    },
    "00:00181:text:000035e6": {
      "resource_row": 52,
