      "source_sha256": "504e8c86d7efe0b36f97c079acec98f256f58c04c12644a4d1a6b47be64a163b",
      "source_offset": 13700,
      "source_byte_length": 14,
      "reference_instructions": [
        11526
      ],
      "text": "I'll be safe."
    },
