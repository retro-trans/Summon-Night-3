      "source_offset": 13824,
      "source_byte_length": 10,
      "reference_instructions": [
        11888
      ],
      "text": "Yes..."
    },
    "00:00181:text:0000360c": {
      "resource_row": 55,
      "source_sha256": "e5b6378ffcd584b94a5c1207d541905970e4b7151207646d53fe524a9899021f",
      "source_offset": 13836,
      "source_byte_length": 14,
      "reference_instructions": [
        11896
      ],
      "text": "My apologies."
    },
    "00:00181:text:0000361c": {
      "resource_row": 56,
      "source_sha256": "fd6620ec119a7a9e86b2c6f14e7d992a269a64f10d63b5843da27eb2aaebc5c8",
      "source_offset": 13852,
      "source_byte_length": 12,
      "reference_instructions": [
        11904
      ],
      "text": "However..."
    },
    "00:00181:text:0000362a": {
      "resource_row": 57,
      "source_sha256": "b8b3e82073b1cf30f73ee6da93b6085035dbdada72589a372fcf68a9820777fb",
      "source_offset": 13866,
      "source_byte_length": 20,
      "reference_instructions": [
        11938
      ],
      "text": "I have confirmed"
    },
    "00:00181:text:00003640": {
      "resource_row": 58,
      "source_sha256": "b5659039e828eca53f1df59863b4306f7ce4dadcf47be7b8575856b6a6edd185",
      "source_offset": 13888,
      "source_byte_length": 14,
      "reference_instructions": [
        11946
      ],
      "text": "the target's current owner..."
    },
    "00:00181:text:00003650": {
      "resource_row": 59,
      "source_sha256": "3c4a100d9c796f7a7a83c9a3588a19e46d5dba776f1861254eaeb3e3c7f8badd",
      "source_offset": 13904,
      "source_byte_length": 4,
      "reference_instructions": [
        11982
      ],
      "text": "?!"
    },
    "00:00181:text:00003656": {
      "resource_row": 60,
      "source_sha256": "f976601580bf310ab97d1e7144203a4d2510ebe718bd509abffc424c7541a953",
      "source_offset": 13910,
      "source_byte_length": 16,
      "reference_instructions": [
        12076
      ],
      "text": "Ishlar..."
    },
    "00:00181:text:00003668": {
      "resource_row": 61,
      "source_sha256": "f485aea7c542dec39ec20b2b6b52314e7decfa0f1d48b17d62b65c21ef147e9c",
      "source_offset": 13928,
      "source_byte_length": 16,
      "reference_instructions": [
        12084
      ],
      "text": "Who were you"
    },
    "00:00181:text:0000367a": {
      "resource_row": 62,
      "source_sha256": "b18b216b783ab546db77a48f6969155b650fcf0309960c74d0547ed44cb9b4f6",
      "source_offset": 13946,
      "source_byte_length": 14,
      "reference_instructions": [
        12092
      ],
      "text": "talking to just now?"
    },
    "00:00181:text:0000368a": {
      "resource_row": 63,
      "source_sha256": "10b82efbc2cf8c769b97bbfafc5b3d7193aaa22f19b0361b5834471d1642ed4e",
      "source_offset": 13962,
      "source_byte_length": 14,
      "reference_instructions": [
        12128
      ],
      "text": "Who...?"
    },
    "00:00181:text:0000369a": {
      "resource_row": 64,
      "source_sha256": "5b5c8c404378f8f24ed92bc692934f4d1bb072d673afb5467582495bde801249",
      "source_offset": 13978,
      "source_byte_length": 14,
      "reference_instructions": [
        12164
      ],
      "text": "Was I"
    },
    "00:00181:text:000036aa": {
      "resource_row": 65,
      "source_sha256": "28baf2091856e1546d7d9ea4a394ec998d7f9c854359b09abda8e57eb6a38012",
      "source_offset": 13994,
      "source_byte_length": 18,
      "reference_instructions": [
        12172
      ],
      "text": "talking to myself"
    },
    "00:00181:text:000036be": {
      "resource_row": 66,
      "source_sha256": "7dc3a5fdf60a861335ef3c7d098a3a80c937c9ac742ecdf3351d3bfcbd396c39",
      "source_offset": 14014,
      "source_byte_length": 12,
      "reference_instructions": [
        12180
      ],
      "text": "again?"
    },
    "00:00181:text:000036cc": {
      "resource_row": 67,
      "source_sha256": "648044d3f07be55bbbfd57364732b2d3ef301fcb4ebca9745074e69dee2db958",
      "source_offset": 14028,
      "source_byte_length": 14,
      "reference_instructions": [
        12196
      ],
      "text": "...Talking to yourself?"
    },
    "00:00181:text:000036dc": {
      "resource_row": 68,
      "source_sha256": "dcbcfc4fcea63d038312adf9aaee715367c6c4ddd060f5e0a50ecdb2e2387943",
      "source_offset": 14044,
      "source_byte_length": 16,
      "reference_instructions": [
        12232
      ],
      "text": "Oh, I'm sorry."
    },
    "00:00181:text:000036ee": {
      "resource_row": 69,
      "source_sha256": "db0446e986f7456d6926429b5dadbc493da998f2166578b3aa6d343bc7cf7307",
      "source_offset": 14062,
      "source_byte_length": 24,
      "reference_instructions": [
        12268
      ],
      "text": "It seems I have a habit"
    },
    "00:00181:text:00003708": {
      "resource_row": 70,
      "source_sha256": "f1513a159467ce744f6212094c998bfd7e8abf830334df3fcf9e7931060cd74f",
      "source_offset": 14088,
      "source_byte_length": 18,
      "reference_instructions": [
        12276
      ],
      "text": "of talking to myself"
    },
    "00:00181:text:0000371c": {
      "resource_row": 71,
      "source_sha256": "ae80e810a0973ab81a4f8fc166d80a07911b5a907d5ec2145a2eed494272428f",
      "source_offset": 14108,
      "source_byte_length": 16,
      "reference_instructions": [
        12284
      ],
      "text": "sometimes..."
    },
    "00:00181:text:0000372e": {
      "resource_row": 72,
      "source_sha256": "fcf668fed4007cb31637ccf6877924bb768a2b02901d1254dc44814f0956f7da",
      "source_offset": 14126,
      "source_byte_length": 20,
      "reference_instructions": [
        12300
      ],
      "text": "Come to think of it,"
    },
    "00:00181:text:00003744": {
      "resource_row": 73,
      "source_sha256": "50f56d40ae5fa8d7c46baa453f8779380117bbe0a2e5f26efdaaf479438d902e",
      "source_offset": 14148,
      "source_byte_length": 20,
      "reference_instructions": [
        12308
      ],
      "text": "when we met on the ship,"
    },
    "00:00181:text:0000375a": {
      "resource_row": 74,
      "source_sha256": "fce508a8745eb5186a0a8837eab560648556d8d442278100db9ab6da5e885bd3",
      "source_offset": 14170,
      "source_byte_length": 20,
      "reference_instructions": [
        12316
      ],
      "text": "he was muttering something too."
    },
    "00:00181:text:00003770": {
      "resource_row": 75,
      "source_sha256": "2afac32f7f8ffa065d17ebe84d9d290dc9d19463e5b0e638be3779cfdc2e2096",
      "source_offset": 14192,
      "source_byte_length": 20,
      "reference_instructions": [
        12352
      ],
      "text": "It's a bad habit, isn't it?"
    },
    "00:00181:text:00003786": {
      "resource_row": 76,
      "source_sha256": "0c2d1d54a4499e4efa9456dcd681c827908b4bf45acd08532432a484681e9ed5",
      "source_offset": 14214,
      "source_byte_length": 16,
      "reference_instructions": [
        12360
      ],
      "text": "I need to stop..."
    },
    "00:00181:text:00003798": {
      "resource_row": 77,
      "source_sha256": "a8b5380007eeb9688b4995ab94db11badb7e98fa3b5558bab994d5136158a4f2",
      "source_offset": 14232,
      "source_byte_length": 20,
      "reference_instructions": [
        12446
      ],
      "text": "Though I suppose"
    },
    "00:00181:text:000037ae": {
      "resource_row": 78,
      "source_sha256": "e9d31819a813a4b991cdef41da3eef57c0a415ead98e27f03404055faa2de67e",
      "source_offset": 14254,
      "source_byte_length": 20,
      "reference_instructions": [
        12454
      ],
      "text": "it's called a habit"
    },
    "00:00181:text:000037c4": {
      "resource_row": 79,
      "source_sha256": "bb7919dda6c8fb5ff26abadfefc0d43de9f76702ff0e0c1b2cd2cc619ed12b7b",
      "source_offset": 14276,
      "source_byte_length": 20,
      "reference_instructions": [
        12462
      ],
      "text": "because it isn't easy to stop."
    },
    "00:00181:text:000037da": {
      "resource_row": 80,
      "source_sha256": "4ec972d9bb03aa5143a72034981c0f11d50b2c7359a17968d7e1abbcd1e36d30",
      "source_offset": 14298,
      "source_byte_length": 24,
      "reference_instructions": [
        12544
      ],
      "text": "Anyway, you shouldn't"
    },
    "00:00181:text:000037f4": {
      "resource_row": 81,
      "source_sha256": "d9c4b59c18faaa41bb7cb25a6948ef55f81dfef93b5c7f3bb23a5c55c8f80fd8",
      "source_offset": 14324,
      "source_byte_length": 22,
      "reference_instructions": [
        12552
      ],
      "text": "be out walking at night."
    },
    "00:00181:text:0000380c": {
      "resource_row": 82,
      "source_sha256": "32b4930c71e2d431f9577d7a07b99a41b1d80f97c1b8bcee9910f76d66280e3f",
      "source_offset": 14348,
      "source_byte_length": 20,
      "reference_instructions": [
        12568
      ],
      "text": "Some of the stray summons"
    },
    "00:00181:text:00003822": {
      "resource_row": 83,
      "source_sha256": "beb38006119ca1f6a92a9280f51baabd34134ef6f903981b779ac3c95d398b9d",
      "source_offset": 14370,
      "source_byte_length": 20,
      "reference_instructions": [
        12576
      ],
      "text": "are quite vicious."
    },
    "00:00181:text:00003838": {
      "resource_row": 84,
      "source_sha256": "ee382dc237224df06e8ec5e59f9c79075b7aa8fad614826b804249e7620f6915",
      "source_offset": 14392,
      "source_byte_length": 18,
      "reference_instructions": [
        12602
      ],
      "text": "I'll walk you back."
    },
    "00:00181:text:0000384c": {
      "resource_row": 85,
      "source_sha256": "ab9ce20042f5e880553f775d7ff12e680e014b80cb832d58574377ca36e200ee",
      "source_offset": 14412,
      "source_byte_length": 14,
      "reference_instructions": [
        12610
      ],
      "text": "Shall we go?"
    },
    "00:00181:text:0000385c": {
      "resource_row": 86,
      "source_sha256": "f8ac19f830979cbd635d4315b9791d2b666b9df7c7d37aae180ab20c49630a3a",
      "source_offset": 14428,
      "source_byte_length": 4,
      "reference_instructions": [
        12646
      ],
      "text": "Yes."
    },
    "00:00181:text:00003862": {
      "resource_row": 87,
      "source_sha256": "eb472143b6f3a6d5abee8acdb97b9b331ae36394826a188d5065d07bf513a66c",
      "source_offset": 14434,
      "source_byte_length": 16,
      "reference_instructions": [
        12654
      ],
      "text": "I'm sorry for the trouble..."
    }
  }
}
