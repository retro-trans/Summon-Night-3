      "source_offset": 13582,
      "source_byte_length": 22,
      "reference_instructions": [
        11460
      ],
      "text": "I want to stay here"
    },
    "00:00181:text:00003526": {
      "resource_row": 43,
      "source_sha256": "1c4c052cf50ff51cc55d769a71b71773debe0262f2ed463dde62b9421203b025",
