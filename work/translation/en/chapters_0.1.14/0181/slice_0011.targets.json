      "source_offset": 13548,
      "source_byte_length": 18,
      "reference_instructions": [
        11418
      ],
      "text": "I understand the situation."
    },
    "00:00181:text:00003500": {
      "resource_row": 41,
      "source_sha256": "21d2b75792eadeed8e03e6644e2932eedd5e017cc4c4719d0a456163c2aafe4a",
      "source_offset": 13568,
      "source_byte_length": 12,
      "reference_instructions": [
        11426
      ],
      "text": "Besides..."
